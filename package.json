{
  "name": "websnapper",
  "version": "0.1.0",
  "description": "A small REST service that returns screenshots of web pages, rendered by a long-lived headless Chromium.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Paul Faulkner (https://headwall-hosting.com)",
  "private": true,
  "bin": {
    "websnapper": "bin/websnapper"
  },
  "files": [
    "dist/",
    "bin/",
    "config/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/cli/main.ts serve",
    "websnapper": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 'tests/**/*.test.ts' 'tools/**/*.test.js'",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "puppeteer-core": "25.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
