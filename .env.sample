# websnapper settings. Copy to .env and adjust. The process environment overrides this file.
# Every setting is described in docs/configuration.md.

# Read settings from this file instead of .env beside package.json. Environment only.
# WEBSNAPPER_ENV_FILE='/etc/websnapper/websnapper.env'

# ---- Server ----

# Address to listen on. 127.0.0.1 keeps it local (behind a reverse proxy); 0.0.0.0 for the LAN.
WEBSNAPPER_HOST='127.0.0.1'

# TCP port.
WEBSNAPPER_PORT='8490'

# Comma-separated IPs or CIDR ranges (10.0.0.0/8) of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty when clients connect directly.
WEBSNAPPER_TRUSTED_PROXIES=''

# Log level: warn | info | debug. Errors are always written.
WEBSNAPPER_LOG_LEVEL='info'

# ---- Authentication ----

# token: every request needs "Authorization: Bearer <token>" (mint with: websnapper key create).
# open: no authentication at all. Must be chosen explicitly.
WEBSNAPPER_AUTH_MODE='token'

# SQLite database holding API keys, URL rules and bans. Relative paths are from the project root.
WEBSNAPPER_DATABASE_PATH='./data/websnapper.sqlite'

# ---- URL policy ----

# open | allow-list | block-list. Rules are managed with: websnapper rule ...
WEBSNAPPER_URL_POLICY='open'

# all: check every request a page makes. navigation: only the page, its redirects and frames.
WEBSNAPPER_URL_POLICY_SCOPE='all'

# ---- Browser and pool ----

# Chromium binary. On Debian/Ubuntu: apt install chromium
WEBSNAPPER_CHROMIUM_PATH='/usr/bin/chromium'

# Snapshots rendered at once. Each uses roughly 100-300 MB.
WEBSNAPPER_POOL_SIZE='3'

# Requests allowed to wait for a slot before new ones get 503.
WEBSNAPPER_QUEUE_MAX='20'

# How long a request may wait for a slot before it gets 503.
WEBSNAPPER_QUEUE_TIMEOUT_MS='15000'

# How long a page may take to load before the request gets 504.
WEBSNAPPER_NAVIGATION_TIMEOUT_MS='20000'

# Relaunch Chromium after this many snapshots, to keep memory in check.
WEBSNAPPER_BROWSER_RECYCLE_AFTER='500'

# Accept invalid or self-signed TLS certificates on target sites.
WEBSNAPPER_IGNORE_TLS_ERRORS='false'

# ---- Snapshot defaults and limits ----

# Format when a request doesn't give one: png | jpeg | webp.
WEBSNAPPER_DEFAULT_FORMAT='png'

# Quality for jpeg and webp when a request doesn't give one, 1-100.
WEBSNAPPER_DEFAULT_QUALITY='80'

# Largest viewport width, in CSS pixels. Presets wider than this are refused and not listed.
WEBSNAPPER_MAX_WIDTH_PX='3840'

# Largest viewport height, in CSS pixels. Presets taller than this are refused and not listed.
WEBSNAPPER_MAX_HEIGHT_PX='2160'

# Full-page captures are cut off at this height. Chromium's limit is 16384.
WEBSNAPPER_MAX_FULL_HEIGHT_PX='16000'

# Largest delay_ms a request may ask for.
WEBSNAPPER_MAX_DELAY_MS='5000'

# ---- Rate limiting and bans ----

# Requests per minute per client address (token bucket refill rate).
WEBSNAPPER_RATE_LIMIT_PER_MINUTE='60'

# Requests a client may make in a burst.
WEBSNAPPER_RATE_LIMIT_BURST='10'

# Failed or rate-limited requests within the window that get a client banned.
WEBSNAPPER_BAN_STRIKES='20'

# Strike window, in seconds.
WEBSNAPPER_BAN_WINDOW_SECONDS='60'

# Ban length, in seconds. Bans lift themselves when they expire.
WEBSNAPPER_BAN_DURATION_SECONDS='900'

# Comma-separated IPs or CIDR ranges never rate-limited or banned (monitoring, your own LAN).
WEBSNAPPER_RATE_LIMIT_EXEMPT=''
